
{
  "manifest_version": 3,
  "name": "ChatGPT Prompt Sender",
  "version": "1.4.0",
  "description": "Insert and send predefined prompts or clipboard text to ChatGPT.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "clipboardRead",
    "offscreen"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html"
  },
  "options_page": "options.html",
  "commands": {
    "send-prompt": {
      "suggested_key": {
        "default": "Ctrl+Shift+R"
      },
      "description": "Send clipboard text to ChatGPT"
    },
    "send-prompt-1": {
      "suggested_key": {
        "default": "Ctrl+Shift+1"
      },
      "description": "Send predefined message 1"
    },
    "send-prompt-2": {
      "suggested_key": {
        "default": "Ctrl+Shift+2"
      },
      "description": "Send predefined message 2"
    },
    "send-prompt-3": {
      "suggested_key": {
        "default": "Ctrl+Shift+3"
      },
      "description": "Send predefined message 3"
    }
  }
}
